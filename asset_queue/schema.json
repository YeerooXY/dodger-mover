{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/YeerooXY/dodger-mover/asset_queue/schema.json",
    "title": "Dodger Mover asset request",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "kind",
        "prompt_summary",
        "priority",
        "estimated_credits",
        "status",
        "created_at",
        "dependencies",
        "slice"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "kind": {
            "type": "string",
            "minLength": 3
        },
        "prompt_summary": {
            "type": "string",
            "minLength": 8
        },
        "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
        },
        "estimated_credits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
        },
        "status": {
            "enum": [
                "draft",
                "pending_approval",
                "approved",
                "cancelled"
            ]
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "not_before": {
            "type": "string",
            "format": "date"
        },
        "dependencies": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "uniqueItems": true
        },
        "slice": {
            "type": "string",
            "pattern": "^S[0-9]{3}$"
        }
    }
}
